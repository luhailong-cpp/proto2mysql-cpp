# Provides MySQL::Client for Oracle MySQL and MariaDB connectors.
find_package(PkgConfig QUIET)
if(PkgConfig_FOUND AND NOT MYSQL_LIBRARY AND NOT MYSQL_INCLUDE_DIR)
    pkg_check_modules(PBMYSQL_MYSQL QUIET IMPORTED_TARGET mysqlclient)
    if(NOT PBMYSQL_MYSQL_FOUND)
        pkg_check_modules(PBMYSQL_MYSQL QUIET IMPORTED_TARGET mariadb)
    endif()
endif()
if(TARGET PkgConfig::PBMYSQL_MYSQL)
    set(MySQL_LIBRARIES PkgConfig::PBMYSQL_MYSQL)
    set(MySQL_INCLUDE_DIRS ${PBMYSQL_MYSQL_INCLUDE_DIRS})
    set(MySQL_VERSION ${PBMYSQL_MYSQL_VERSION})
else()
    find_path(MYSQL_INCLUDE_DIR mysql.h HINTS ${MYSQL_ROOT} ENV MYSQL_ROOT PATH_SUFFIXES include include/mysql include/mariadb mysql mariadb)
    if(WIN32)
        find_library(MYSQL_LIBRARY NAMES libmysql libmariadb mysqlclient mysql mariadb HINTS ${MYSQL_ROOT} ENV MYSQL_ROOT PATH_SUFFIXES lib lib64)
    else()
        find_library(MYSQL_LIBRARY NAMES mysqlclient libmysql mysql mariadb libmariadb HINTS ${MYSQL_ROOT} ENV MYSQL_ROOT PATH_SUFFIXES lib lib64)
    endif()
    set(MySQL_LIBRARIES ${MYSQL_LIBRARY})
    set(MySQL_INCLUDE_DIRS ${MYSQL_INCLUDE_DIR})
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(MySQL REQUIRED_VARS MySQL_LIBRARIES MySQL_INCLUDE_DIRS VERSION_VAR MySQL_VERSION)
if(MySQL_FOUND AND NOT TARGET MySQL::Client)
    if(TARGET PkgConfig::PBMYSQL_MYSQL)
        add_library(MySQL::Client INTERFACE IMPORTED)
        set_target_properties(MySQL::Client PROPERTIES INTERFACE_LINK_LIBRARIES PkgConfig::PBMYSQL_MYSQL)
    else()
        if(WIN32)
            get_filename_component(_pbmysql_library_dir "${MYSQL_LIBRARY}" DIRECTORY)
            find_file(MYSQL_RUNTIME_LIBRARY NAMES libmysql.dll libmariadb.dll HINTS "${_pbmysql_library_dir}" "${_pbmysql_library_dir}/../bin" NO_DEFAULT_PATH)
        endif()
        if(WIN32 AND MYSQL_RUNTIME_LIBRARY)
            add_library(MySQL::Client SHARED IMPORTED)
            set_target_properties(MySQL::Client PROPERTIES IMPORTED_IMPLIB "${MYSQL_LIBRARY}" IMPORTED_LOCATION "${MYSQL_RUNTIME_LIBRARY}")
        else()
            add_library(MySQL::Client UNKNOWN IMPORTED)
            set_target_properties(MySQL::Client PROPERTIES IMPORTED_LOCATION "${MYSQL_LIBRARY}")
        endif()
        set_target_properties(MySQL::Client PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${MYSQL_INCLUDE_DIR}")
    endif()
endif()
mark_as_advanced(MYSQL_INCLUDE_DIR MYSQL_LIBRARY MYSQL_RUNTIME_LIBRARY)
