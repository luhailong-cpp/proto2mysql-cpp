include_guard(GLOBAL)

# Generate C++ messages and register the files for Database::RegisterAllTables().
# The generated objects are retained even when target is a static library and
# the application never names one of its message types.
function(pbmysql_generate_cpp target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "pbmysql_generate_cpp: target '${target}' does not exist")
    endif()
    get_target_property(_alias "${target}" ALIASED_TARGET)
    get_target_property(_type "${target}" TYPE)
    if(_alias OR NOT _type MATCHES "^(EXECUTABLE|STATIC_LIBRARY)$")
        message(FATAL_ERROR "pbmysql_generate_cpp requires an executable or static library target; call it on the final executable or its static proto target")
    endif()
    cmake_parse_arguments(PB "" "" "PROTOS;IMPORT_DIRS" ${ARGN})
    if(PB_UNPARSED_ARGUMENTS OR NOT PB_PROTOS)
        message(FATAL_ERROR "pbmysql_generate_cpp(target PROTOS files... [IMPORT_DIRS directories...])")
    endif()
    if(NOT TARGET pbmysql::proto2mysql OR NOT TARGET protobuf::protoc)
        message(FATAL_ERROR "find_package(proto2mysql CONFIG REQUIRED) before pbmysql_generate_cpp")
    endif()
    set(_imports)
    foreach(_dir IN LISTS PB_IMPORT_DIRS)
        get_filename_component(_dir "${_dir}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND _imports "${_dir}")
    endforeach()
    list(APPEND _imports "${CMAKE_CURRENT_SOURCE_DIR}" "${PBMYSQL_PROTO_DIR}")
    if(Protobuf_INCLUDE_DIRS)
        list(APPEND _imports ${Protobuf_INCLUDE_DIRS})
    else()
        get_target_property(_protobuf_imports protobuf::libprotobuf INTERFACE_INCLUDE_DIRECTORIES)
        list(APPEND _imports ${_protobuf_imports})
    endif()
    list(REMOVE_DUPLICATES _imports)
    set(_import_args)
    foreach(_dir IN LISTS _imports)
        if(_dir AND NOT _dir MATCHES "^\\$<")
            list(APPEND _import_args "--proto_path=${_dir}")
        endif()
    endforeach()
    string(MAKE_C_IDENTIFIER "${target}" _id)
    get_property(_counter GLOBAL PROPERTY PBMYSQL_GENERATION_COUNTER)
    if(NOT _counter)
        set(_counter 0)
    endif()
    math(EXPR _counter "${_counter}+1")
    set_property(GLOBAL PROPERTY PBMYSQL_GENERATION_COUNTER "${_counter}")
    set(_object_target "_pbmysql_generated_${_id}_${_counter}")
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/${_object_target}")
    file(MAKE_DIRECTORY "${_output}")
    set(_generated)
    set(_names)
    set(_registry "#include \"src/mysql_wrapper/descriptor_registry.h\"\nnamespace {\n")
    foreach(_proto IN LISTS PB_PROTOS)
        get_filename_component(_absolute "${_proto}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${_absolute}" OR NOT _absolute MATCHES "\\.proto$")
            message(FATAL_ERROR "pbmysql_generate_cpp: invalid proto '${_proto}'")
        endif()
        set(_relative)
        foreach(_dir IN LISTS _imports)
            if(_dir AND NOT _dir MATCHES "^\\$<")
                file(RELATIVE_PATH _candidate "${_dir}" "${_absolute}")
                if(NOT IS_ABSOLUTE "${_candidate}" AND NOT _candidate MATCHES "^\\.\\.(/|$)")
                    set(_relative "${_candidate}")
                    break()
                endif()
            endif()
        endforeach()
        if(NOT _relative)
            message(FATAL_ERROR "pbmysql_generate_cpp: '${_proto}' is outside its import directories")
        endif()
        if(_relative MATCHES "[\n\r\t]")
            message(FATAL_ERROR "pbmysql_generate_cpp: control characters in proto path")
        endif()
        list(FIND _names "${_relative}" _seen)
        if(NOT _seen EQUAL -1)
            message(FATAL_ERROR "pbmysql_generate_cpp: duplicate import name '${_relative}'")
        endif()
        list(APPEND _names "${_relative}")
        string(REGEX REPLACE "\\.proto$" "" _stem "${_relative}")
        set(_cc "${_output}/${_stem}.pb.cc")
        set(_header "${_output}/${_stem}.pb.h")
        set(_depfile "${_output}/${_stem}.pb.d")
        set(_depfile_argument)
        if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.21 OR CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
            set(_depfile_argument DEPFILE "${_depfile}")
        endif()
        add_custom_command(OUTPUT "${_cc}" "${_header}"
            COMMAND protobuf::protoc "--cpp_out=${_output}" "--dependency_out=${_depfile}"
                ${_import_args} "${_absolute}"
            DEPENDS "${_absolute}" protobuf::protoc
            ${_depfile_argument} VERBATIM)
        list(APPEND _generated "${_cc}" "${_header}")
        string(REPLACE "\\" "\\\\" _escaped "${_relative}")
        string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
        list(LENGTH _names _index)
        string(APPEND _registry "const ::pbmysql::ProtoFileRegistration file_${_index}(\"${_escaped}\");\n")
    endforeach()
    string(APPEND _registry "}\n")
    file(GENERATE OUTPUT "${_output}/registry.cpp" CONTENT "${_registry}")
    add_library("${_object_target}" OBJECT ${_generated} "${_output}/registry.cpp")
    target_link_libraries("${_object_target}" PUBLIC pbmysql::proto2mysql)
    target_include_directories("${_object_target}" PUBLIC "${_output}")
    set_target_properties("${_object_target}" PROPERTIES POSITION_INDEPENDENT_CODE ON)
    if(MSVC)
        target_compile_options("${_object_target}" PRIVATE /utf-8)
    endif()
    target_sources("${target}" PRIVATE $<TARGET_OBJECTS:${_object_target}>)
    if(_type STREQUAL "STATIC_LIBRARY")
        target_sources("${target}" INTERFACE $<TARGET_OBJECTS:${_object_target}>)
    endif()
    target_include_directories("${target}" PUBLIC "${_output}")
    target_link_libraries("${target}" PUBLIC pbmysql::proto2mysql)
    add_dependencies("${target}" "${_object_target}")
endfunction()
