@PACKAGE_INIT@
set(_pbmysql_package_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_package(Protobuf CONFIG QUIET)
if(NOT Protobuf_FOUND)
    find_dependency(Protobuf)
endif()
set(_pbmysql_saved_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(MySQL)
set(CMAKE_MODULE_PATH "${_pbmysql_saved_module_path}")
unset(_pbmysql_saved_module_path)
include("${CMAKE_CURRENT_LIST_DIR}/proto2mysqlTargets.cmake")
set(PBMYSQL_PROTO_DIR "${_pbmysql_package_prefix}/@CMAKE_INSTALL_DATADIR@/proto2mysql/proto")
include("${CMAKE_CURRENT_LIST_DIR}/pbmysql_generate_cpp.cmake")
unset(_pbmysql_package_prefix)
check_required_components(proto2mysql)
